#!/bin/sh
# Ativação (uma vez por clone): git config core.hooksPath .hooks
# Roda os checks necessários no push quando houver mudança em app/ ou api/ desde o remoto.
upstream="$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null)"

check_app=0
check_api=0

if [ -z "$upstream" ]; then
  check_app=1
  check_api=1
else
  if ! git diff --quiet "${upstream}...HEAD" -- app/ 2>/dev/null; then
    check_app=1
  fi
  if ! git diff --quiet "${upstream}...HEAD" -- api/ 2>/dev/null; then
    check_api=1
  fi
fi

if [ "$check_app" -eq 1 ]; then
  echo "[pre-push] verificando o app (typecheck + testes)..."
  npm --prefix app run check || exit 1
fi

if [ "$check_api" -eq 1 ]; then
  echo "[pre-push] verificando a api (bun test)..."
  (cd api && bun test) || exit 1
fi
